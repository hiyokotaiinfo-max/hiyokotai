<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ヒヨコ隊 - 日本語教師の卵を応援する素材置き場</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.19.0/dist/tabler-icons.min.css">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#FFFBF5;font-family:'Hiragino Sans','Hiragino Kaku Gothic ProN','Noto Sans JP',sans-serif;color:#412402;}
a{text-decoration:none;color:inherit;}

/* ヘッダー */
.header{background:#FFF8EE;border-bottom:0.5px solid #F5C4B3;padding:0 1.5rem;position:sticky;top:0;z-index:100;}
.header-inner{max-width:900px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:56px;}
.logo{display:flex;align-items:center;gap:8px;cursor:pointer;}
.logo-icon{width:32px;height:32px;background:#FAEEDA;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;}
.logo-text{font-size:17px;font-weight:600;color:#633806;}
.logo-sub{font-size:11px;color:#854F0B;}
.nav{display:flex;gap:4px;}
.nav-btn{font-size:13px;padding:6px 12px;border-radius:8px;border:none;background:transparent;color:#854F0B;cursor:pointer;transition:background 0.15s;}
.nav-btn:hover,.nav-btn.active{background:#FAEEDA;font-weight:500;}

/* ページ切替 */
.page{display:none;}
.page.show{display:block;}

/* ヒーロー */
.hero{background:#FFF8EE;padding:2.5rem 1.5rem 2rem;text-align:center;border-bottom:0.5px solid #F5C4B3;}
.hero-title{font-size:24px;font-weight:600;color:#412402;margin-bottom:8px;}
.hero-sub{font-size:14px;color:#854F0B;line-height:1.7;max-width:480px;margin:0 auto 1.25rem;}
.search-wrap{max-width:480px;margin:0 auto;display:flex;gap:8px;}
.search-wrap input{flex:1;padding:9px 16px;border-radius:99px;border:1px solid #F5C4B3;background:#FFFBF5;font-size:14px;color:#412402;outline:none;}
.search-wrap input:focus{border-color:#EF9F27;}
.search-btn{padding:9px 20px;border-radius:99px;border:none;background:#EF9F27;color:#412402;font-size:14px;font-weight:500;cursor:pointer;}

/* フィルター */
.filter-row{max-width:900px;margin:1.25rem auto 0;padding:0 1.5rem;display:flex;gap:8px;flex-wrap:wrap;align-items:center;}
.filter-label{font-size:12px;color:#854F0B;}
.tag{font-size:12px;padding:5px 14px;border-radius:99px;border:1px solid #F5C4B3;background:#FFFBF5;color:#633806;cursor:pointer;transition:background 0.15s;}
.tag.active{background:#FAEEDA;border-color:#EF9F27;font-weight:500;}
.tag:hover{background:#FFF8EE;}

/* メイン */
.main{max-width:900px;margin:0 auto;padding:1.5rem;display:grid;grid-template-columns:1fr 220px;gap:16px;align-items:start;}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;}
.section-title{font-size:15px;font-weight:500;color:#412402;}
.sort-select{font-size:12px;padding:5px 10px;border-radius:8px;border:0.5px solid #F5C4B3;background:#FFFBF5;color:#633806;}

/* ギャラリー */
.gallery{columns:3;gap:12px;}
@media(max-width:600px){.gallery{columns:2;}.main{grid-template-columns:1fr;}}
.card{break-inside:avoid;margin-bottom:12px;background:#fff;border:0.5px solid #F5C4B3;border-radius:12px;overflow:hidden;cursor:pointer;transition:border-color 0.15s;}
.card:hover{border-color:#EF9F27;}
.card-img{width:100%;display:flex;align-items:center;justify-content:center;padding:1rem;}
.card-body{padding:10px 12px 12px;}
.card-title{font-size:13px;font-weight:500;color:#412402;margin-bottom:6px;}
.card-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;}
.card-author{font-size:11px;color:#854F0B;display:flex;align-items:center;gap:4px;}
.author-dot{width:18px;height:18px;border-radius:50%;background:#FAEEDA;display:flex;align-items:center;justify-content:center;font-size:10px;color:#633806;font-weight:500;}
.card-dl{font-size:11px;color:#B4B2A9;display:flex;align-items:center;gap:3px;}
.dl-btn{width:100%;padding:7px;border-radius:8px;border:1px solid #F5C4B3;background:#FFF8EE;color:#633806;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;transition:background 0.15s;}
.dl-btn:hover{background:#FAEEDA;border-color:#EF9F27;}
.ai-badge{font-size:10px;padding:2px 7px;border-radius:99px;background:#EAF3DE;color:#27500A;margin-left:4px;}

/* サイドバー */
.sidebar{}
.side-card{background:#FFF8EE;border:0.5px solid #F5C4B3;border-radius:12px;padding:1rem 1.25rem;margin-bottom:12px;}
.side-title{font-size:13px;font-weight:500;color:#633806;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.rank-row{display:flex;align-items:center;gap:10px;font-size:13px;padding:4px 0;}
.rank-num{width:20px;font-weight:500;color:#EF9F27;text-align:center;flex-shrink:0;}
.rank-name{flex:1;color:#412402;}
.rank-dl{font-size:11px;color:#B4B2A9;}

/* リクエストボックス */
.req-box{background:#FFF8EE;border:1.5px dashed #F5C4B3;border-radius:12px;padding:1rem 1.25rem;margin-top:1rem;cursor:pointer;text-align:center;transition:border-color 0.15s;}
.req-box:hover{border-color:#EF9F27;}
.req-title{font-size:13px;font-weight:500;color:#633806;margin-bottom:4px;}
.req-sub{font-size:12px;color:#854F0B;}

/* モーダル */
.modal-overlay{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(65,36,2,0.4);z-index:200;align-items:center;justify-content:center;}
.modal-overlay.show{display:flex;}
.modal{background:#FFFBF5;border-radius:16px;border:0.5px solid #F5C4B3;padding:1.5rem;max-width:340px;width:90%;}
.modal-img{width:100%;border-radius:8px;margin-bottom:1rem;display:flex;align-items:center;justify-content:center;padding:1.5rem;}
.modal-title{font-size:16px;font-weight:500;color:#412402;margin-bottom:6px;}
.modal-author{font-size:13px;color:#854F0B;margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.modal-stats{display:flex;gap:12px;margin-bottom:1.25rem;}
.stat{font-size:12px;color:#854F0B;display:flex;align-items:center;gap:4px;}
.modal-dl-btn{width:100%;padding:11px;border-radius:8px;border:none;background:#EF9F27;color:#412402;font-size:14px;font-weight:500;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;margin-bottom:8px;}
.modal-close{width:100%;padding:8px;border-radius:8px;border:0.5px solid #F5C4B3;background:transparent;color:#854F0B;font-size:13px;cursor:pointer;}

/* aboutページ */
.about-wrap{max-width:720px;margin:0 auto;padding:2rem 1.5rem;}
.about-hero{text-align:center;padding:2rem 0 2.5rem;}
.chick{font-size:56px;margin-bottom:1rem;}
.about-title{font-size:22px;font-weight:600;color:#412402;margin-bottom:8px;}
.about-sub{font-size:15px;color:#854F0B;line-height:1.7;}
.about-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin:1.5rem 0;}
.acard{background:#fff;border:0.5px solid #F5C4B3;border-radius:12px;padding:1.25rem;}
.acard-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:10px;font-size:18px;}
.acard-title{font-size:14px;font-weight:500;color:#412402;margin-bottom:6px;}
.acard-text{font-size:13px;color:#854F0B;line-height:1.6;}
.about-rule{background:#FFF8EE;border:0.5px solid #F5C4B3;border-radius:12px;padding:1.25rem 1.5rem;margin:1.5rem 0;}
.rule-title{font-size:14px;font-weight:500;color:#633806;margin-bottom:10px;display:flex;align-items:center;gap:6px;}
.rule-row{display:flex;align-items:flex-start;gap:8px;padding:5px 0;font-size:13px;color:#412402;}
.about-admin{background:#fff;border:0.5px solid #F5C4B3;border-radius:12px;padding:1.25rem 1.5rem;margin:1.5rem 0;display:flex;align-items:flex-start;gap:16px;}
.admin-avatar{width:52px;height:52px;border-radius:50%;background:#FAEEDA;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.admin-name{font-size:15px;font-weight:500;color:#412402;margin-bottom:4px;}
.admin-text{font-size:13px;color:#854F0B;line-height:1.6;}
.admin-note{font-size:11px;color:#B4B2A9;margin-top:4px;}
.contact-row{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;}
.contact-btn{font-size:12px;padding:5px 12px;border-radius:99px;border:0.5px solid #F5C4B3;background:#FFF8EE;color:#633806;cursor:pointer;}

/* 提供者ページ */
.contrib-wrap{max-width:760px;margin:0 auto;padding:2rem 1.5rem;}
.contrib-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;}
.contrib-title{font-size:18px;font-weight:500;color:#412402;}
.period-select{font-size:12px;padding:5px 10px;border-radius:8px;border:0.5px solid #F5C4B3;background:#FFFBF5;color:#633806;}
.ranking-top{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:1.5rem;align-items:end;}
.rank-card{background:#fff;border:0.5px solid #F5C4B3;border-radius:12px;padding:1rem;text-align:center;}
.rank-card.first{border-color:#EF9F27;border-width:1.5px;}
.rank-num-big{font-size:18px;font-weight:500;margin-bottom:8px;}
.rank-avatar-big{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:500;margin:0 auto 8px;}
.rank-name-big{font-size:14px;font-weight:500;color:#412402;margin-bottom:2px;}
.rank-dl-big{font-size:12px;color:#854F0B;}
.contrib-list{display:flex;flex-direction:column;gap:8px;}
.contrib-row{background:#fff;border:0.5px solid #F5C4B3;border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:14px;}
.contrib-rank{width:28px;font-size:14px;font-weight:500;color:#EF9F27;text-align:center;flex-shrink:0;}
.contrib-avatar{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:500;flex-shrink:0;}
.contrib-name{font-size:14px;font-weight:500;color:#412402;}
.contrib-tags{display:flex;gap:4px;margin-top:3px;flex-wrap:wrap;}
.ctag{font-size:10px;padding:2px 7px;border-radius:99px;background:#FFF8EE;border:0.5px solid #F5C4B3;color:#854F0B;}
.contrib-stats{text-align:right;flex-shrink:0;}
.contrib-dl{font-size:15px;font-weight:500;color:#412402;}
.contrib-dl-label{font-size:11px;color:#B4B2A9;}
.join-box{background:#FFF8EE;border:1.5px dashed #F5C4B3;border-radius:12px;padding:1.25rem;margin-top:1.5rem;text-align:center;cursor:pointer;transition:border-color 0.15s;}
.join-box:hover{border-color:#EF9F27;}

/* フッター */
.footer{background:#FFF8EE;border-top:0.5px solid #F5C4B3;padding:1.5rem;text-align:center;margin-top:3rem;}
.footer-text{font-size:12px;color:#B4B2A9;line-height:1.8;}
</style>
</head>
