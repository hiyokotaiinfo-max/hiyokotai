<script>
const cards = [
  {title:'あいさつカード（ひよこセット）',author:'さくら先生',dl:142,ai:true,cat:'あいさつ',bg:'#FFF8EE'},
  {title:'動詞カード「たべます」',author:'田中たろう',dl:98,ai:false,cat:'動詞',bg:'#E1F5EE'},
  {title:'初級教案テンプレート vol.1',author:'みどり',dl:76,ai:false,cat:'教案',bg:'#FAECE7'},
  {title:'食べ物カード（肉・魚・野菜）',author:'はな先生',dl:201,ai:true,cat:'食べ物',bg:'#EEEDFE'},
  {title:'感情カード「うれしい」',author:'さくら先生',dl:55,ai:false,cat:'絵カード',bg:'#FFF8EE'},
  {title:'N5文型練習シート',author:'田中たろう',dl:33,ai:false,cat:'教案',bg:'#EAF3DE'},
];

function showPage(id, btn) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('show'));
  document.getElementById(id).classList.add('show');
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  window.scrollTo(0,0);
}

function filterTag(el) {
  document.querySelectorAll('.tag').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
}

function openModal(i) {
  const c = cards[i];
  const imgs = document.querySelectorAll('.card-img');
  const modalImg = document.getElementById('modalImg');
  modalImg.style.background = c.bg;
  modalImg.innerHTML = imgs[i].innerHTML;
  document.getElementById('modalTitle').textContent = c.title + (c.ai ? '【AI生成】' : '');
  document.getElementById('modalAuthor').innerHTML = c.author + 'のイラスト';
  document.getElementById('modalStats').innerHTML =
    '<span class="stat"><i class="ti ti-download" style="font-size:14px;"></i>' + c.dl + ' DL</span>' +
    '<span class="stat"><i class="ti ti-tag" style="font-size:14px;"></i>' + c.cat + '</span>' +
    (c.ai ? '<span class="stat" style="color:#27500A;"><i class="ti ti-sparkles" style="font-size:14px;"></i>AI生成</span>' : '');
  document.getElementById('modalOverlay').classList.add('show');
}

function closeModal(e) {
  if(e.target === document.getElementById('modalOverlay')) {
    document.getElementById('modalOverlay').classList.remove('show');
  }
}
</script>
